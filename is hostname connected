let data = `analytics:/entities/source/lldp/v1`
let hostnames = newDict()

for cell, value in data {
    for ip, details in value {
        hostnames[ip] = details["hostname"]
    }
}

let presence = newDict()
presence["device1"] = newDict()
presence["device2"] = newDict()
presence["device3"] = newDict()
presence["device4"] = newDict()
presence["device5"] = newDict()

presence["device1"]["Connected"] = "no"
presence["device2"]["Connected"] = "no"
presence["device3"]["Connected"] = "no"
presence["device4"]["Connected"] = "no"
presence["device5"]["Connected"] = "no"

for ip, hostname in hostnames {
    if hostname == "device1" {
        presence["device1"]["Connected"] = "yes"
    }
    if hostname == "device2" {
        presence["device2"]["Connected"] = "yes"
    }
    if hostname == "device3" {
        presence["device3"]["Connected"] = "yes"
    }
    if hostname == "device4" {
        presence["device4"]["Connected"] = "yes"
    }
    if hostname == "device5" {
        presence["device5"]["Connected"] = "yes"
    }
}

presence
